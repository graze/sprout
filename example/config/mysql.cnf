#
# Minimal MySQL 8.4 configuration for the sprout example stack.
#
# For explanations see
# http://dev.mysql.com/doc/mysql/en/server-system-variables.html

[client]
port   = 3306
socket = /var/run/mysqld/mysqld.sock

[mysqld]
host_cache_size  = 0
skip-name-resolve
user     = mysql
socket   = /var/run/mysqld/mysqld.sock
pid-file = /var/run/mysqld/mysqld.pid
datadir  = /var/lib/mysql
port     = 3306

# The example schema declares `timestamp NOT NULL DEFAULT '0000-00-00 00:00:00'`.
# Clearing sql_mode drops NO_ZERO_DATE so that legacy zero-date default loads.
sql_mode = ''

# Keep the footprint small for local/example use.
innodb_buffer_pool_size = 64M

# Additional settings shipped with the image override those above.
!includedir /etc/mysql/conf.d/
